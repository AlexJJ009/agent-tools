{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tools.local/linear-workflow/batch.schema.json",
  "title": "Normalized Linear Workflow Batch",
  "type": "object",
  "required": ["schema_version", "workflow_version", "id", "status", "risk_profile", "included_issues", "acceptance", "full_ci_point", "work_references"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "workflow_version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+"},
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9]+-[1-9][0-9]*"},
    "status": {"type": "string", "enum": ["Backlog", "Ready", "In Progress", "In Review", "Blocked", "Done", "Canceled"]},
    "risk_profile": {"type": "string", "enum": ["fast", "standard", "high"]},
    "included_issues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "[A-Z][A-Z0-9]+-[1-9][0-9]*"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "full_ci_point": {"type": "string", "minLength": 1},
    "work_references": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["repository_full_name", "base_branch", "base_sha", "working_branch", "candidate_sha"], "properties": {
      "repository_full_name": {"type": "string", "pattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"},
      "base_branch": {"type": "string", "minLength": 1},
      "base_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
      "working_branch": {"type": "string", "pattern": "linear/[a-z0-9-]+"},
      "candidate_sha": {"type": ["string", "null"], "pattern": "[0-9a-f]{40}"}
    }, "additionalProperties": false}}
  },
  "additionalProperties": false
}

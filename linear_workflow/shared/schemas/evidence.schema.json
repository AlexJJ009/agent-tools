{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tools.local/linear-workflow/evidence.schema.json",
  "title": "Normalized PR, CI, and review evidence",
  "type": "object",
  "required": ["schema_version", "workflow_version", "linear_batch", "linear_issues", "repository_full_name", "base_branch", "base_sha", "working_branch", "candidate_sha", "github_pull_request", "risk_profile", "pull_request", "commits", "required_checks", "base_review_verdicts", "review_verdicts", "verdict_commit_path_changes", "reviewer_context", "changed_paths", "gate_policy_source", "gate_policy_sha"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "workflow_version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+"},
    "linear_batch": {"type": "string", "pattern": "[A-Z][A-Z0-9]+-[1-9][0-9]*"},
    "linear_issues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "[A-Z][A-Z0-9]+-[1-9][0-9]*"}},
    "repository_full_name": {"type": "string", "pattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"},
    "base_branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "working_branch": {"type": "string", "pattern": "linear/[a-z0-9-]+"},
    "candidate_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "github_pull_request": {"type": "string", "pattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*"},
    "risk_profile": {"type": "string", "enum": ["fast", "standard", "high"]},
    "pull_request": {"type": "object", "required": ["github_pull_request", "repository_full_name", "base_branch", "head_branch", "head_sha", "draft"], "properties": {
      "github_pull_request": {"type": "string", "pattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*"},
      "repository_full_name": {"type": "string", "pattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"},
      "base_branch": {"type": "string", "minLength": 1},
      "head_branch": {"type": "string", "pattern": "linear/[a-z0-9-]+"},
      "head_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
      "draft": {"type": "boolean"}
    }, "additionalProperties": false},
    "commits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sha", "subject", "path_changes"], "properties": {"sha": {"type": "string", "pattern": "[0-9a-f]{40}"}, "subject": {"type": "string", "minLength": 1}, "path_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["path", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["added", "modified", "deleted"]}}, "additionalProperties": false}}}, "additionalProperties": false}},
    "required_checks": {"type": "array", "items": {"type": "object", "required": ["name", "sha", "status", "url"], "properties": {"name": {"type": "string", "minLength": 1}, "sha": {"type": "string", "pattern": "[0-9a-f]{40}"}, "status": {"type": "string", "enum": ["success", "failure", "pending", "cancelled"]}, "url": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "base_review_verdicts": {"type": "array", "items": {"type": "object"}},
    "review_verdicts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verdict_commit_path_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["path", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["added", "modified", "deleted"]}}, "additionalProperties": false}},
    "reviewer_context": {"type": "object", "required": ["candidate_sha", "files"], "properties": {"candidate_sha": {"type": "string", "pattern": "[0-9a-f]{40}"}, "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gate_policy_source": {"type": "string", "enum": ["base"]},
    "gate_policy_sha": {"type": "string", "pattern": "[0-9a-f]{40}"}
  },
  "additionalProperties": false
}
